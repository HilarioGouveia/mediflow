# Gemini API configuration
GEMINI_API_KEY="sua_chave_gemini"
GEMINI_MODEL_NAME="gemini-3.5-flash"

# OCI configuration
OCI_CONFIG_FILE="~/.oci/config"
OCI_CONFIG_PROFILE="DEFAULT"
OCI_NAMESPACE="seu_tenancy_namespace"
OCI_BUCKET_NAME="mediflow-documentos-clinicos"

# Opcional: vazio registra alertas apenas em log
WEBHOOK_URL=""

# memory = efemero; emulator = OCI local; oci = Oracle Cloud real
STORAGE_MODE="memory"
# Para executar a API no Windows com o emulador no Docker:
OCI_SERVICE_ENDPOINT="http://localhost:4599"
